{
  "defaultEnvironment": "TEST",
  "environmentVersionOverrides": {
    "TEST": {
      "enabled": true,
      "version": "11.4.42.01"
    },
    "PROD": {
      "enabled": true,
      "version": "11.3.25.03"
    }
  },
  "defaultSite": "ALL",
  "defaultProduct": "ALL",
  "defaultProject": "chromium",
  "fullyParallel": true,
  "workers": 3,
  "parallelWorkers": 3,
  "headless": true,
  "slowMo": 0,
  "maximizeWindow": true,
  "viewport": null,
  "video": "retain-on-failure",
  "openPlaywrightReport": true,
  "openExcelReport": false,
  "retryLimit": 8,
  "profileRetryLimit": 5,
  "validationRetryLimit": 3,
  "includeSites": "ALL",
  "includeProducts": "ALL",
  "userDataDir": "testData",
  "logLevel": "info"
}
