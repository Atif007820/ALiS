{
  "name": "hmb-playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Playwright framework for NJ HMB registration, login-apply, and approval flows.",
  "type": "module",
  "scripts": {
    "hmb": "node scripts/run-hmb.mjs",
    "test": "node scripts/run-hmb.mjs",
    "hmb:list": "node scripts/run-hmb.mjs --list",
    "hmb:register": "node scripts/run-hmb.mjs --spec=register",
    "hmb:apply": "node scripts/run-hmb.mjs --spec=apply",
    "hmb:approve": "node scripts/run-hmb.mjs --spec=approve",
    "hmb:e2e": "node scripts/run-hmb.mjs",
    "hmb:headed": "node scripts/run-hmb.mjs --headed",
    "hmb:e2e:headed": "node scripts/run-hmb.mjs --headed",
    "validate": "node --test tools/hmb-runtime-regression.test.js",
    "report": "node scripts/run-hmb.mjs --report",
    "browsers:install": "playwright install chromium firefox msedge"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
