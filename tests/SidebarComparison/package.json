{
  "name": "sidebar-comparision",
  "version": "1.0.0",
  "description": "Playwright framework for comparing sidebar menu items across multiple URL pairs.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "sidebar": "node ./scripts/runSidebar.js",
    "sidebar:list": "node ./scripts/runSidebar.js --list",
    "test:sidebar": "playwright test CompareSidebar.spec.js",
    "test:chrome": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "list": "playwright test --list",
    "test:reports": "node --test reporters/tests/nativeReports.test.js",
    "test:urls": "node --test config/tests/*.test.js",
    "report": "playwright show-report --host 127.0.0.1 --port 0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "exceljs": "^4.4.0"
  }
}
