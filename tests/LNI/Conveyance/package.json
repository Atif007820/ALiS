{
  "name": "conveyance-playwright-framework",
  "version": "2.0.0",
  "description": "Conveyance Playwright framework for LNI registration and permit application flows.",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "npx playwright install",
    "validate:flows": "node --test scripts/tests/*.test.mjs",
    "conv": "node scripts/run-conveyance.mjs --e2e",
    "test": "node scripts/run-conveyance.mjs --standalone",
    "test:serial": "node scripts/run-conveyance.mjs --e2e --serial",
    "test:headed": "node scripts/run-conveyance.mjs --e2e --headed",
    "test:debug": "node scripts/run-conveyance.mjs --e2e --debug",
    "test:all": "node scripts/run-conveyance.mjs --e2e --AppType=ALL --PerType=ALL",
    "test:list": "node scripts/run-conveyance.mjs --e2e --list",
    "test:matrix": "node scripts/run-conveyance.mjs --e2e --AppType=ALL --PerType=ALL --parallel=4",
    "test:register": "node scripts/run-conveyance.mjs --standalone --spec=register",
    "test:apply": "node scripts/run-conveyance.mjs --standalone --spec=apply",
    "test:approve": "node scripts/run-conveyance.mjs --standalone --spec=approve",
    "test:firefox": "node scripts/run-conveyance.mjs -- --workers=1 --project=firefox",
    "test:edge": "node scripts/run-conveyance.mjs -- --workers=1 --project=\"Microsoft Edge\"",
    "test:chrome": "node scripts/run-conveyance.mjs -- --workers=1 --project=chromium",
    "report": "playwright show-report",
    "clean": "node scripts/clean-results.mjs"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  },
  "engines": {
    "node": ">=18"
  }
}
